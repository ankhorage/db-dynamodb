{
  "name": "@ankhorage/db-dynamodb",
  "version": "0.2.0",
  "description": "DynamoDB adapter for @ankhorage/contracts/db.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.build.json",
    "check-types": "bun x tsc --noEmit -p tsconfig.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "paradox",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "prepack": "bun run build",
    "test": "bun test src test",
    "test:standalone": "bun .github/scripts/test-standalone.ts",
    "typecheck": "bun run check-types",
    "version-packages": "ankhorage-changeset version",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0"
  },
  "dependencies": {
    "@ankhorage/contracts": "^26.7.0",
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^2.4.3",
    "@ankhorage/doctor": "0.14.35",
    "@ankhorage/paradox": "^0.3.6",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "ankhorage",
    "database",
    "dynamodb",
    "aws",
    "adapter",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/db-dynamodb.git"
  },
  "homepage": "https://github.com/ankhorage/db-dynamodb#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/db-dynamodb/issues"
  }
}
